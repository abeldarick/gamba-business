# Configuration SasPay (ne jamais commiter de vraies cles dans Git)
# En developpement : sk_test_... | En production : sk_live_...
SASPAY_API_KEY=

# Secret de signature du webhook SasPay (affiche une seule fois a la creation dans app.saspay.me)
SASPAY_WEBHOOK_SECRET=

# URL publique exacte de l'application (https://, sans / final)
APP_URL=https://gamba-business.vercel.app
